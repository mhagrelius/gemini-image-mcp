# Gemini Image MCP Server Configuration

# Required: Your Google Gemini API key
GEMINI_API_KEY=your_api_key_here

# Optional: Default model for image generation
# Options: gemini-2.0-flash-exp
GEMINI_DEFAULT_MODEL=gemini-2.0-flash-exp

# Optional: Default directory for saving generated images
# GEMINI_DEFAULT_OUTPUT_DIR=./generated_images

# Optional: Maximum number of images per batch request (default: 10)
# GEMINI_MAX_BATCH_SIZE=10

# Optional: Default number of concurrent requests for batch operations (default: 3)
# GEMINI_DEFAULT_MAX_CONCURRENT=3
